# =============================================================================
# NEXORA PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env.local for local development.
# In Vercel, set these environment variables in: Project Settings -> Environment Variables.

# 1. Supabase Public Client Credentials (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 2. Cloudflare Turnstile Bot Protection (Required in Production)
# Obtain from Cloudflare Dashboard -> Turnstile -> Add Site
# For local testing, official Cloudflare test keys can be used:
# Sitekey (Always Passes): 1x00000000000000000000AA
# Secret (Always Passes):  1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key-here
TURNSTILE_SECRET_KEY=your-cloudflare-turnstile-secret-key-here

# 3. Application Base URL (Optional - Vercel sets this automatically)
# NEXT_PUBLIC_SITE_URL=https://your-production-app.vercel.app

# 4. Market Data Providers (Optional - If using dedicated external data feeds)
# FINNHUB_API_KEY=your-finnhub-api-key-here

# 5. Distributed Serverless Rate Limiting (Optional - Upstash Redis for Vercel/Edge)
# When provided, replaces in-memory rate limiting with distributed Redis sliding window
# UPSTASH_REDIS_REST_URL=https://your-upstash-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token-here
